@model ShowStringParam
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@_localization.Getkey("EditShowStringParam").Value</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <input asp-for="Id" hidden />
            <div class="border p-3 mt-4">
                @*<div asp-validation-summary="ModelOnly"></div>*@
               <div class="form-floating py-2 col-12">
                    <input asp-for="Name" class="form-control border-0 shadow" />
                    <label asp-for="Name" class="ms-2">@_localization.Getkey("ShowStringParamName").Value</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-check py-2 col-12">
                    <input asp-for="IsShow" class="form-check-input" type="checkbox" />
                    <label asp-for="IsShow" class="form-check-label ms-2">@_localization.Getkey("IsShow").Value</label>
                    <span asp-validation-for="IsShow" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="XPos" type="number" class="form-control border-0 shadow" />
                    <label asp-for="XPos" class="ms-2">@_localization.Getkey("XPos").Value</label>
                    <span asp-validation-for="XPos" class="text-danger"></span>
                </div>  
                <div class="form-floating py-2 col-12">
                    <input asp-for="YPos" type="number" class="form-control border-0 shadow" />
                    <label asp-for="YPos" class="ms-2">@_localization.Getkey("YPos").Value</label>
                    <span asp-validation-for="YPos" class="text-danger"></span>
                </div>  
                <div class="form-floating py-2 col-12">
                    <input asp-for="Description" class="form-control border-0 shadow" />
                    <label asp-for="Description" class="ms-2">@_localization.Getkey("Description").Value</label>
                    @* <span asp-validation-for="Description" class="text-danger"></span> *@
                </div>  
                <div class="form-check py-2 col-12">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label ms-2">@_localization.Getkey("IsActive").Value</label>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>


                <div class="row mt-3">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">Update</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="ShowStringParam" asp-action="Index" class="btn btn-secondary border  form-control">
                            @_localization.Getkey("BacktoList").Value
                        </a>
                    </div>
                </div>


            </div>
        </form>
    </div>
</div>


@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}