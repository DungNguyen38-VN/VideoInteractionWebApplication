@model Camera

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@_localization.Getkey("CreateNewCamera").Value</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="border p-3">
                @*<div asp-validation-summary="ModelOnly"></div>*@
                <div class="form-floating py-2 col-12">
                    <input asp-for="Name" class="form-control border-0 shadow" />
                    <label asp-for="Name" class="ms-2">@_localization.Getkey("CameraName").Value</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="CameraCode" class="form-control border-0 shadow" />
                    <label asp-for="CameraCode" class="ms-2">@_localization.Getkey("CameraCode").Value</label>
                    <span asp-validation-for="CameraCode" class="text-danger"></span>
                </div>   
                <div class="form-floating py-2 col-12">
                    <input asp-for="Description" class="form-control border-0 shadow" />
                    <label asp-for="Description" class="ms-2">@_localization.Getkey("Description").Value</label>
                </div>
                <div class="form-floating py-2 col-12">
                    <input asp-for="CameraIp" class="form-control border-0 shadow" />
                    <label asp-for="CameraIp" class="ms-2">@_localization.Getkey("CameraIp").Value</label>
                    <span asp-validation-for="CameraIp" class="text-danger"></span>
                </div>  
                <div class="form-floating py-2 col-12">
                    <input asp-for="L1ControlId" class="form-control border-0 shadow" />
                    <label asp-for="L1ControlId" class="ms-2">@_localization.Getkey("L1ControlId").Value</label>
                    <span asp-validation-for="L1ControlId" class="text-danger"></span>
                </div>
                <div class="form-floating py-2 col-12">
                    <select asp-for="ShowStringParamId" class="form-select border-0 shadow" asp-items="ViewBag.ShowStringParamList">
                        <option value="">-- @_localization.Getkey("SelectShowStringParam").Value --</option>
                    </select>
                    <label asp-for="ShowStringParamId" class="ms-2">@_localization.Getkey("ShowStringParam").Value</label>
                    <span asp-validation-for="ShowStringParamId" class="text-danger"></span>
                </div>
                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">@_localization.Getkey("Create").Value</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Camera" asp-action="Index" class="btn btn-outline-primary border  form-control">
                            @_localization.Getkey("BacktoList").Value
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>




@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}